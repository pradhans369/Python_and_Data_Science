r\nfrom transformers import ViTImageProcessor, ViTModel\n\n# 1. Load ViT feature extractor\ndevice = tr.device(\"cuda\" if tr.cuda.is_available() else \"cpu\")\nprocessor = ViTImageProcessor.from_pretrained(\"google/vit-base-patch16-224\")\nvit_model = ViTModel.from_pretrained(\"google/vit-base-patch16-224\").to(device)\nvit_model.eval()\n\n# ====================================================================================================================\n# 🔴 CHANGE 1: Define vocab mapping and generate_caption() autoregressive function\n# ====================================================================================================================\nindex_to_word = {i: word for i, word in enumerate(vocab)}\nstart_id = vocab.index('<start>')\nend_id = vocab.index('<end>')\n\ndef generate_caption(img_vec, max_tokens=37):\n    img_input = np.array([img_vec])\n    caption_seq = [start_id]\n    \n    for _ in range(max_tokens - 1):\n        # Pad caption to fixed sequence length (37)\n        padded_caption = caption_seq + [0] * (max_tokens - len(caption_seq))\n        caption_input = np.array([padded_caption])\n        \n        # Predict next word distribution\n        preds = model.predict([img_input, caption_input], verbose=0)\n        \n        # Pick the token with highest probability for the current position\n        next_token_id = int(np.argmax(preds[0, len(caption_seq) - 1, :]))\n        \n        if next_token_id == end_id or next_token_id == 0:\n            break\n            \n        caption_seq.append(next_token_id)\n        \n    # Exclude <start> and assemble words\n    words = [index_to_word.get(idx, '') for idx in caption_seq[1:]]\n    return ' '.join(words)\n\n# ====================================================================================================================\n# 2. Fetch image from URL, extract features, and predict\n# ====================================================================================================================\ndef predict_caption_from_url(image_url):\n    headers = {\n        \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"\n    }\n    response = requests.get(image_url, headers=headers)\n    img = Image.open(io.BytesIO(response.content)).convert(\"RGB\")\n\n    inputs = processor(images=img, return_tensors=\"pt\").to(device)\n    with tr.no_grad():\n        outputs = vit_model(**inputs)\n    img_vec = outputs.pooler_output.detach().cpu().numpy()[0]\n\n    predicted_caption = generate_caption(img_vec)\n\n    plt.figure(figsize=(6, 6))\n    plt.imshow(img)\n    plt.title(f\"Predicted Caption:\\n{predicted_caption}\", fontsize=12)\n    plt.axis(\"off\")\n    plt.show()\n\n    return predicted_caption\n\n# 3. Test on Unsplash image\nurl = \"https://images.unsplash.com/photo-1791514122824-a10c01b1864e?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D\"\ncaption = predict_caption_from_url(url)\nprint(\"Caption:\", caption)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:42:34.588833Z","iopub.execute_input":"2026-10-24T01:42:34.589225Z","iopub.status.idle":"2026-10-24T01:42:35.777087Z","shell.execute_reply.started":"2026-10-24T01:42:34.589198Z","shell.execute_reply":"2026-10-24T01:42:35.776002Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/198 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"56c4e9cc4d42484097b29749d55c8750"}},"metadata":{}},{"name":"stderr","text":"[transformers] \u001b[1mViTModel LOAD REPORT\u001b[0m from: google/vit-base-patch16-224\nKey                 | Status     | \n--------------------+------------+-\nclassifier.bias     | UNEXPECTED | \nclassifier.weight   | UNEXPECTED | \npooler.dense.bias   | MISSING    | \npooler.dense.weight | MISSING    | \n\nNotes:\n- UNEXPECTED:\tcan be ignored when loading from different task/architecture; not ok if you expect identical arch.\n- MISSING:\tthose params were newly initialized because missing from the checkpoint. Consider training on your downstream task.\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mNameError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_48/3301150410.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     46\u001b[0m \u001b[0;31m# 3. Run prediction on your Unsplash link\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     47\u001b[0m \u001b[0murl\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;34m\"https://images.unsplash.com/photo-1791514122824-a10c01b1864e?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D\"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 48\u001b[0;31m \u001b[0mcaption\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mpredict_caption_from_url\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0murl\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     49\u001b[0m \u001b[0mprint\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\"Caption:\"\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcaption\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/tmp/ipykernel_48/3301150410.py\u001b[0m in \u001b[0;36mpredict_caption_from_url\u001b[0;34m(image_url)\u001b[0m\n\u001b[1;32m     32\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     33\u001b[0m   \u001b[0;31m# Generate caption with your trained Keras model\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 34\u001b[0;31m   \u001b[0mpredicted_caption\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mgenerate_caption\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mimg_vec\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001