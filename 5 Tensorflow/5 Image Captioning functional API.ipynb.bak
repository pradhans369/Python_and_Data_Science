T01:37:06.814650Z"}},"outputs":[],"execution_count":5},{"cell_type":"code","source":"type(train)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:06.817183Z","iopub.execute_input":"2026-10-24T01:37:06.817541Z","iopub.status.idle":"2026-10-24T01:37:06.823184Z","shell.execute_reply.started":"2026-10-24T01:37:06.817506Z","shell.execute_reply":"2026-10-24T01:37:06.822337Z"}},"outputs":[{"execution_count":6,"output_type":"execute_result","data":{"text/plain":"pandas.core.frame.DataFrame"},"metadata":{}}],"execution_count":6},{"cell_type":"markdown","source":"### **Text preprocessing**","metadata":{}},{"cell_type":"code","source":"!pip install cleantext\n\nfrom cleantext import clean\nfrom tensorflow.keras.layers import TextVectorization","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:06.824425Z","iopub.execute_input":"2026-10-24T01:37:06.824787Z","iopub.status.idle":"2026-10-24T01:37:10.682218Z","shell.execute_reply.started":"2026-10-24T01:37:06.824759Z","shell.execute_reply":"2026-10-24T01:37:10.681435Z"}},"outputs":[{"name":"stdout","text":"Collecting cleantext\n  Downloading cleantext-1.1.4-py3-none-any.whl.metadata (3.5 kB)\nRequirement already satisfied: nltk in /usr/local/lib/python3.13/dist-packages (from cleantext) (3.9.1)\nRequirement already satisfied: click in /usr/local/lib/python3.13/dist-packages (from nltk->cleantext) (8.5.0)\nRequirement already satisfied: joblib in /usr/local/lib/python3.13/dist-packages (from nltk->cleantext) (1.6.0)\nRequirement already satisfied: regex>=2021.8.3 in /usr/local/lib/python3.13/dist-packages (from nltk->cleantext) (2025.11.3)\nRequirement already satisfied: tqdm in /usr/local/lib/python3.13/dist-packages (from nltk->cleantext) (4.67.3)\nRequirement already satisfied: cloudpickle>=3.0 in /usr/local/lib/python3.13/dist-packages (from joblib->nltk->cleantext) (3.1.2)\nDownloading cleantext-1.1.4-py3-none-any.whl (4.9 kB)\nInstalling collected packages: cleantext\nSuccessfully installed cleantext-1.1.4\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"def text_clean(txt):\n    txt = clean(\n        txt,\n        lowercase = True,\n        punct = True,\n        extra_spaces = True\n    )\n\n    return f\"<start> {txt} <end>\"\n\n\ndef text_clean_2(df):\n    for i in ['caption_0', 'caption_1', 'caption_2', 'caption_3', 'caption_4']:\n        df[i] = df[i].map(text_clean)                   # this sends the data sample by sample to the function\n\n    return df\n\n\ntrain = text_clean_2(train)                      # this sends the entire dataframe to the function\ntest = text_clean_2(test)\nvalidation = text_clean_2(validation)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:10.683572Z","iopub.execute_input":"2026-10-24T01:37:10.685045Z","iopub.status.idle":"2026-10-24T01:37:17.343874Z","shell.execute_reply.started":"2026-10-24T01:37:10.685017Z","shell.execute_reply":"2026-10-24T01:37:17.343164Z"}},"outputs":[],"execution_count":8},{"cell_type":"code","source":"train['caption_0'].shape","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:17.344854Z","iopub.execute_input":"2026-10-24T01:37:17.345186Z","iopub.status.idle":"2026-10-24T01:37:17.352938Z","shell.execute_reply.started":"2026-10-24T01:37:17.345139Z","shell.execute_reply":"2026-10-24T01:37:17.352052Z"}},"outputs":[{"execution_count":9,"output_type":"execute_result","data":{"text/plain":"(6000,)"},"metadata":{}}],"execution_count":9},{"cell_type":"code","source":"train.head(3)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:17.356434Z","iopub.execute_input":"2026-10-24T01:37:17.356852Z","iopub.status.idle":"2026-10-24T01:37:17.397750Z","shell.execute_reply.started":"2026-10-24T01:37:17.356823Z","shell.execute_reply":"2026-10-24T01:37:17.396648Z"}},"outputs":[{"execution_count":10,"output_type":"execute_result","data":{"text/plain":"                                                 img  \\\n0  <PIL.JpegImagePlugin.JpegImageFile image mode=...   \n1  <PIL.JpegImagePlugin.JpegImageFile image mode=...   \n2  <PIL.JpegImagePlugin.JpegImageFile image mode=...   \n\n                                           caption_0  \\\n0  <start> a black dog is running after a white d...   \n1          <start> a little baby plays croquet <end>   \n2  <start> a brown dog in the snow has something ...   \n\n                                           caption_1  \\\n0  <start> black dog chasing brown dog through sn...   \n1  <start> a little girl plays croquet next to a ...   \n2  <start> a brown dog in the snow holding a pink...   \n\n                                           caption_2  \\\n0  <start> two dogs chase each other across the s...   \n1  <start> the child is playing croquette by the ...   \n2  <start> a brown dog is holding a pink shirt in...   \n\n                                           caption_3  \\\n0   <start> two dogs play together in the snow <end>   \n1  <start> the kid is in front of a car with a pu...   \n2  <start> a dog is carrying something pink in it...   \n\n                                           caption_4  \n0  <start> two dogs running through a low lying b...  \n1  <start> the little boy is playing with a croqu...  \n2  <start> a dog with something pink in its mouth...  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>img</th>\n      <th>caption_0</th>\n      <th>caption_1</th>\n      <th>caption_2</th>\n      <th>caption_3</th>\n      <th>caption_4</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>&lt;PIL.JpegImagePlugin.JpegImageFile image mode=...</td>\n      <td>&lt;start&gt; a black dog is running after a white d...</td>\n      <td>&lt;start&gt; black dog chasing brown dog through sn...</td>\n      <td>&lt;start&gt; two dogs chase each other across the s...</td>\n      <td>&lt;start&gt; two dogs play together in the snow &lt;end&gt;</td>\n      <td>&lt;start&gt; two dogs running through a low lying b...</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>&lt;PIL.JpegImagePlugin.JpegImageFile image mode=...</td>\n      <td>&lt;start&gt; a little baby plays croquet &lt;end&gt;</td>\n      <td>&lt;start&gt; a little girl plays croquet next to a ...</td>\n      <td>&lt;start&gt; the child is playing croquette by the ...</td>\n      <td>&lt;start&gt; the kid is in front of a car with a pu...</td>\n      <td>&lt;start&gt; the little boy is playing with a croqu...</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>&lt;PIL.JpegImagePlugin.JpegImageFile image mode=...</td>\n      <td>&lt;start&gt; a brown dog in the snow has something ...</td>\n      <td>&lt;start&gt; a brown dog in the snow holding a pink...</td>\n      <td>&lt;start&gt; a brown dog is holding a pink shirt in...</td>\n      <td>&lt;start&gt; a dog is carrying something pink in it...</td>\n      <td>&lt;start&gt; a dog with something pink in its mouth...</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":10},{"cell_type":"code","source":"def make_lists(df):\n    imgs, captions = [], []\n    \n    for sample in range(len(df)):\n        for i in range(5):\n            captions.append(df[f\"caption_{i}\"].iloc[sample])\n            imgs.append(df['img'].iloc[sample])\n\n    return imgs, captions\n\n\ntrain_imgs, train_captions = make_lists(train)\ntest_imgs, test_captions = make_lists(test)\nvalidation_imgs, validation_captions = make_lists(validation)\n\n\nprint(len(train_imgs))\nprint(len(train_captions))\nprint()\nprint(len(test_imgs))\nprint(len(test_captions))\nprint()\nprint(len(validation_imgs))\nprint(len(validation_captions))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:17.398941Z","iopub.execute_input":"2026-10-24T01:37:17.399283Z","iopub.status.idle":"2026-10-24T01:37:53.475325Z","shell.execute_reply.started":"2026-10-24T01:37:17.399253Z","shell.execute_reply":"2026-10-24T01:37:53.474528Z"}},"outputs":[{"name":"stdout","text":"30000\n30000\n\n5000\n5000\n\n5000\n5000\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"max_len = max(len(i.split()) for i in train_captions)\nprint(f\"CAPTION HOLDING MAXIMUM LENGTH: {max_len}\")\n\nvectorizer = TextVectorization(\n    max_tokens=None, output_mode='int', output_sequence_length=max_len\n)\n\nvectorizer.adapt(train_captions)                      # this makes a dictionary of vocab\n\nvocab = vectorizer.get_vocabulary()\nprint(f\"REAL VOCABULARY SIZE: {len(vocab)}\")  # Will be ~7,632!\n\ntrain_captions = vectorizer(train_captions).numpy()\ntest_captions = vectorizer(test_captions).numpy()\nvalidation_captions = vectorizer(validation_captions).numpy()\n\nprint()\nprint(\"Train shape:\", train_captions.shape)\nprint(\"Test shape:\", test_captions.shape)\nprint(\"Validation shape:\", validation_captions.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:53.476779Z","iopub.execute_input":"2026-10-24T01:37:53.477140Z","iopub.status.idle":"2026-10-24T01:37:56.420891Z","shell.execute_reply.started":"2026-10-24T01:37:53.477116Z","shell.execute_reply":"2026-10-24T01:37:56.419899Z"}},"outputs":[{"name":"stdout","text":"CAPTION HOLDING MAXIMUM LENGTH: 38\n","output_type":"stream"},{"name":"stderr","text":"WARNING: All log messages before absl::InitializeLog() is called are written to STDERR\nI0000 00:00:1792805873.875112      48 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:0 with 13756 MB memory:  -> device: 0, name: Tesla T4, pci bus id: 0000:00:04.0, compute capability: 7.5\nI0000 00:00:1792805873.878102      48 gpu_device.cc:2020] Created device /job:localhost/replica:0/task:0/device:GPU:1 with 13756 MB memory:  -> device: 1, name: Tesla T4, pci bus id: 0000:00:05.0, compute capability: 7.5\n","output_type":"stream"},{"name":"stdout","text":"REAL VOCABULARY SIZE: 7632\n\nTrain shape: (30000, 38)\nTest shape: (5000, 38)\nValidation shape: (5000, 38)\n","output_type":"stream"}],"execution_count":12},{"cell_type":"code","source":"test_captions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:56.422183Z","iopub.execute_input":"2026-10-24T01:37:56.422560Z","iopub.status.idle":"2026-10-24T01:37:56.429163Z","shell.execute_reply.started":"2026-10-24T01:37:56.422536Z","shell.execute_reply":"2026-10-24T01:37:56.428291Z"}},"outputs":[{"execution_count":13,"output_type":"execute_result","data":{"text/plain":"array([[ 4,  6, 32, ...,  0,  0,  0],\n       [ 4,  6, 32, ...,  0,  0,  0],\n       [ 4, 14, 26, ...,  0,  0,  0],\n       ...,\n       [ 4,  2, 26, ...,  0,  0,  0],\n       [ 4,  2, 10, ...,  0,  0,  0],\n       [ 4,  2, 10, ...,  0,  0,  0]])"},"metadata":{}}],"execution_count":13},{"cell_type":"markdown","source":"### **Pre-Trained model feature extraction**","metadata":{}},{"cell_type":"code","source":"import torch as tr\nfrom transformers import ViTImageProcessor, ViTModel","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:37:56.430818Z","iopub.execute_input":"2026-10-24T01:37:56.431284Z","iopub.status.idle":"2026-10-24T01:38:20.975169Z","shell.execute_reply.started":"2026-10-24T01:37:56.431253Z","shell.execute_reply":"2026-10-24T01:38:20.974433Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"if tr.cuda.is_available():\n    device = tr.device('cuda')\n\n\nprocessor = ViTImageProcessor.from_pretrained('google/vit-base-patch16-224')           # for extracting or using the features from model\nmodel = ViTModel.from_pretrained('google/vit-base-patch16-224')                        # for using the model\nmodel = model.to(device)\nmodel.eval()\n\n\ndef img_vectorizer(images):\n    img_vector = []\n    \n    for i in images:\n        img = i.convert('RGB')\n        inputs = processor(images=img, return_tensors='pt').to(device)\n\n        with tr.no_grad():\n            outputs = model(**inputs)\n\n        vec = outputs.pooler_output.detach().cpu().numpy()[0]\n        img_vector.append(vec)\n        \n    return img_vector\n\n\ntrain_imgs = img_vectorizer(train['img'])\ntest_imgs = img_vectorizer(test['img'])\nvalidation_imgs = img_vectorizer(validation['img'])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:38:20.976243Z","iopub.execute_input":"2026-10-24T01:38:20.977105Z","iopub.status.idle":"2026-10-24T01:40:36.075523Z","shell.execute_reply.started":"2026-10-24T01:38:20.977072Z","shell.execute_reply":"2026-10-24T01:40:36.074765Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"preprocessor_config.json:   0%|          | 0.00/160 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b92953915dda42398cb16d19cf9f4b10"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/69.7k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4b8eec2b15174846986261230e211af1"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"model.safetensors: reconstructing file:   0%|          |  0.00B /  346MB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"a1c30f19ede342fd9f851dd6835532e8"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"model.safetensors: downloading bytes:           |  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"9088c0cdb1784bddb4c1f7912479da83"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/198 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"956a6fa2dcb646b5810c2f2e99328844"}},"metadata":{}},{"name":"stderr","text":"[transformers] \u001b[1mViTModel LOAD REPORT\u001b[0m from: google/vit-base-patch16-224\nKey                 | Status     | \n--------------------+------------+-\nclassifier.bias     | UNEXPECTED | \nclassifier.weight   | UNEXPECTED | \npooler.dense.bias   | MISSING    | \npooler.dense.weight | MISSING    | \n\nNotes:\n- UNEXPECTED:\tcan be ignored when loading from different task/architecture; not ok if you expect identical arch.\n- MISSING:\tthose params were newly initialized because missing from the checkpoint. Consider training on your downstream task.\n","output_type":"stream"}],"execution_count":15},{"cell_type":"code","source":"print(len(train_imgs))\nprint(len(test_imgs))\nprint(len(validation_imgs))\n\nlen(train_imgs[0])                           # each img is of the shape of 1 x 768 dimensions","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:40:36.076702Z","iopub.execute_input":"2026-10-24T01:40:36.077086Z","iopub.status.idle":"2026-10-24T01:40:36.084363Z","shell.execute_reply.started":"2026-10-24T01:40:36.077061Z","shell.execute_reply":"2026-10-24T01:40:36.083446Z"}},"outputs":[{"name":"stdout","text":"6000\n1000\n1000\n","output_type":"stream"},{"execution_count":16,"output_type":"execute_result","data":{"text/plain":"768"},"metadata":{}}],"execution_count":16},{"cell_type":"markdown","source":"### **Transformer decoder architecture**","metadata":{}},{"cell_type":"code","source":"vocab = vectorizer.get_vocabulary()\nlen_1 = len(vocab)\nlen_2 = len(train_captions[0]) - 1\n\nprint(f\"LENGTH OF IMAGE INPUTS : {len(train_imgs[0])}\")\nprint(f\"LENGTH OF CAPTION INPUTS : {len_2}\")\nprint(f\"LENGTH OF THE VOCABULARY : {len_1}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:40:36.085711Z","iopub.execute_input":"2026-10-24T01:40:36.086593Z","iopub.status.idle":"2026-10-24T01:40:36.122516Z","shell.execute_reply.started":"2026-10-24T01:40:36.086520Z","shell.execute_reply":"2026-10-24T01:40:36.121893Z"}},"outputs":[{"name":"stdout","text":"LENGTH OF IMAGE INPUTS : 768\nLENGTH OF CAPTION INPUTS : 37\nLENGTH OF THE VOCABULARY : 7632\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code","source":"train_imgs[0].shape","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:40:36.123507Z","iopub.execute_input":"2026-10-24T01:40:36.123833Z","iopub.status.idle":"2026-10-24T01:40:36.129266Z","shell.execute_reply.started":"2026-10-24T01:40:36.123809Z","shell.execute_reply":"2026-10-24T01:40:36.128553Z"}},"outputs":[{"execution_count":18,"output_type":"execute_result","data":{"text/plain":"(768,)"},"metadata":{}}],"execution_count":18},{"cell_type":"code","source":"import keras_nlp\nfrom tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:40:36.130199Z","iopub.execute_input":"2026-10-24T01:40:36.130411Z","iopub.status.idle":"2026-10-24T01:40:38.459429Z","shell.execute_reply.started":"2026-10-24T01:40:36.130391Z","shell.execute_reply":"2026-10-24T01:40:38.458762Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"train_imgs = np.repeat(np.array(train_imgs), 5, axis=0)\nvalidation_imgs = np.repeat(np.array(validation_imgs), 5, axis=0)\n\ntrain_captions_x = train_captions[:, :-1]           # not sending the -1 (<end>)      # In x (input): <end> is excluded ([:-1])\ny_train_captions  = train_captions[:, 1:]                    # not sending the 1 (<start>)     # In y (target): <end> is included (because the model must learn to output it at the end from the input of x)\n\n# We dont send the <start> in y because the model never needs to generate <start>. We give <start> to the model to kick off the generation.\n# We hand the model [<start>] in x and say: \"Here is the image, and here is your starting signal. What is the first word?\"\n\nvalidation_captions_x = validation_captions[:, :-1]\ny_validation_captions = validation_captions[:, 1:]\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:40:38.460433Z","iopub.execute_input":"2026-10-24T01:40:38.460908Z","iopub.status.idle":"2026-10-24T01:40:38.540447Z","shell.execute_reply.started":"2026-10-24T01:40:38.460869Z","shell.execute_reply":"2026-10-24T01:40:38.539500Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"def masked_loss(y_true, y_pred):\n    mask = tf.math.not_equal(y_true, 0)\n    loss_object = tf.keras.losses.SparseCategoricalCrossentropy(\n        from_logits=False, reduction='none'\n    )\n    \n    loss = loss_object(y_true, y_pred)\n    mask = tf.cast(mask, dtype=loss.dtype)\n    loss *= mask\n    \n    return tf.reduce_sum(loss) / (tf.reduce_sum(mask) + 1e-7)\n\n\ndef masked_accuracy(y_true, y_pred):\n    pred_tokens = tf.argmax(y_pred, axis=-1, output_type=y_true.dtype)\n    matches = tf.math.equal(y_true, pred_tokens)\n    mask = tf.math.not_equal(y_true, 0)\n    matches = tf.math.logical_and(matches, mask)\n    \n    return tf.reduce_sum(tf.cast(matches, dtype=tf.float32)) / (tf.reduce_sum(tf.cast(mask, dtype=tf.float32)) + 1e-7)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:57:54.571327Z","iopub.execute_input":"2026-10-24T01:57:54.572133Z","iopub.status.idle":"2026-10-24T01:57:54.579364Z","shell.execute_reply.started":"2026-10-24T01:57:54.572100Z","shell.execute_reply":"2026-10-24T01:57:54.578405Z"}},"outputs":[],"execution_count":23},{"cell_type":"code","source":"\n# ====================================================================================================================\n# taking img and caption inputs\n\ninputs_image = layers.Input(shape=(768,))\ninputs_captions = layers.Input(shape=(len_2,))\n\n# ====================================================================================================================\n# making the caption embedding (embedding + positional embedding)\n\nembedding = layers.Embedding(input_dim=len_1, output_dim=256)(inputs_captions)\npositional_embedding = keras_nlp.layers.PositionEmbedding(sequence_length=len_2)(embedding)\ncaption_embedding = embedding + positional_embedding\n\n# ====================================================================================================================\n# converting imgs into the vector dimension of 256\n\nimg_vector_1 = layers.Dense(256, activation='relu')(inputs_image)                 # here we are producing 256 shape vector coz we have caption embedding of 256 dimensions, so to do future dot product of img and the caption embeddings we have to convert the img into the same dimension as the dimension of caption embeddings\nimg_vector_2 = layers.Reshape((1, 256))(img_vector_1) \n\n# ====================================================================================================================\n\nx = keras_nlp.layers.TransformerDecoder(intermediate_dim=512, num_heads=4, dropout=0.3)(caption_embedding, encoder_sequence=img_vector_2)\n\n# ====================================================================================================================\n\noutputs = layers.Dense(len_1, activation='softmax')(x)\n\n\nmodel = keras.Model(\n    inputs = [inputs_image, inputs_captions],\n    outputs = outputs\n)\n\n\nmodel.compile(\n    optimizer = tf.keras.optimizers.Adam(1e-4),\n    loss = masked_loss,\n    metrics = [masked_accuracy]\n)\n\n\nearly_stopping = EarlyStopping(\n    monitor = 'val_loss',\n    patience = 5,\n    restore_best_weights = True,\n    verbose = 1\n)\n\n\nreduce_lr = ReduceLROnPlateau(\n    monitor = 'val_loss',\n    factor = 0.5,\n    patience = 2,\n    min_lr = 1e-6,\n    verbose = 1\n)\n\n\n\n\nhistory = model.fit(\n    x = [train_imgs, train_captions_x],\n    y = y_train_captions,\n    validation_data = ([validation_imgs, validation_captions_x], y_validation_captions),\n    batch_size = 64,\n    epochs = 20,\n    callbacks = [early_stopping, reduce_lr]\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-24T01:58:24.490492Z","iopub.execute_input":"2026-10-24T01:58:24.491566Z","iopub.status.idle":"2026-10-24T02:02:08.250886Z","shell.execute_reply.started":"2026-10-24T01:58:24.491534Z","shell.execute_reply":"2026-10-24T02:02:08.250147Z"}},"outputs":[{"name":"stdout","text":"Epoch 1/20\n\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m31s\u001b[0m 42ms/step - loss: 5.5072 - masked_accuracy: 0.2013 - val_loss: 4.4066 - val_masked_accuracy: 0.2772 - learning_rate: 1.0000e-04\nEpoch 2/20\n\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 22ms/step - loss: 4.0707 - masked_accuracy: 0.3094 - val_loss: 3.8880 - val_masked_accuracy: 0.3244 - learning_rate: 1.0000e-04\nEpoch 3/20\n\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 22ms/step - loss: 3.6850 - masked_accuracy: 0.3394 - val_loss: 3.6761 - val_masked_accuracy: 0.3423 - learning_rate: 1.0000e-04\nEpoch 4/20\n\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 22ms/step - loss: 3.4629 - masked_accuracy: 0.3560 - val_loss: 3.5264 - val_masked_accuracy: 0.3531 - learning_rate: 1.0000e-04\nEpoch 5/20\n\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m10s\u001b[0m 22ms/step - loss: 3.3010 - masked_accuracy: 0.3695 - val_loss: 3.4338 - val_masked_accuracy: 0.3606 - learning_rate: 1.0000e-04\nEpoch 6/20\n\u001b[1m469/469\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m11s\u001b[0m 23ms/step - loss: 3.1733 - masked_accuracy: 0.3800 - val_loss: 3.3735 - val_masked_accuracy: 0.3673 - learning_rate: 1.000